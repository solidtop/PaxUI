/// @desc Per-part styles for sliders, plus the parts' sizes.
function PaxSliderStyles() constructor {
    track = PaxStyle.build_solid(#3F3F46);
    fill = PaxStyle.build_solid(#6366F1);
    handle = PaxStyle.build_solid(#E4E4E7);
    handle_hovered = PaxStyle.build_solid(#FFFFFF);
    handle_focused = PaxStyle.build_solid(#F4F4F5);
    track_height = 8;
    handle_size = 16;
}